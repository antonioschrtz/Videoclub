<odoo>
  <data>

    <!-- ACTION -->

    <record id="action_videoclub_movie_wizard" model="ir.actions.act_window">
      <field name="name">Find movies by genres</field>
      <field name="res_model">videoclub.movie_wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

    <!-- VIEW -->

    <record id="videoclub_movie_wizard_form" model="ir.ui.view">
      <field name="name">videoclub_movie_wizard_form</field>
      <field name="model">videoclub.movie_wizard</field>
      <field name="arch" type="xml">
        <form string="Find movies by genres">
          <group>
            <field name="genre_ids" widget="many2many_tags"/>
          </group>
          <footer>
            <button name="action_search" string="Search" type="object" class="oe_highlight"/>
            <button string="Cancel" type="object" special="cancel" class="oe_button"/>
          </footer>
        </form>
      </field>
    </record>

    <!-- MENU -->

    <menuitem id="menu_videoclub_movie_wizard" name="Find movies by genres"
              parent="menu_videoclub_root" action="action_videoclub_movie_wizard" sequence="40"
              groups="videoclub.group_videoclub_client,videoclub.group_videoclub_manager"/>

  </data>
</odoo>
